node_modules/
dist/
.env
.env.*
!.env.example
.dev.vars
.wrangler/
.grok/
*.log
/tmp/
# Scratch verdict files. Recorded evidence that backs a committed result lives
# in evidence/ and IS tracked -- a score whose inputs are gitignored cannot be
# reproduced or audited, which is how an unverifiable result gets trusted.
orchestrator/.verdicts-*.json

# Visual-review screenshot runs. Reproducible on demand by re-running the visual
# review; ~1.2 MB of PNGs per run is not worth carrying in history.
review-*/

# D1 exports. Kept out of git by default so a future export containing real user
# data cannot be committed by reflex. Add one explicitly with `git add -f` when
# an export is genuinely meant to be tracked.
backups/*.sql
# Full-repo bundles. A backup of the repo does not belong inside the repo.
backups/*.bundle

# Playwright traces are run artifacts, not source — hyg-no-binaries forbids committing them.
evidence/*.zip
evidence/traces/

# Playwright's generated HTML report and traces. Regenerated by any run, and the
# trace zips are binaries that trip hyg-no-binaries. Evidence that backs a score
# lives in evidence/ and stays tracked.
playwright-report/
test-results/

# Scratch source dumps from transcription runs. The sourced rows live in
# migrations/ and SOURCES.md; the raw dumps are reproducible and not evidence.
tmp-sources/

# Generation intermediates for crop art. Shipped WebP assets live in
# az-planting-calendar/public/crops/; raw JPG sources are not product evidence.
**/design-refs/crop-art/raw/

# Design-option raster previews under design-refs/ (HTML decisions stay tracked).
# hyg-no-binaries only allows public/assets/static/images/screenshots for images.
**/design-refs/**/*.png
**/design-refs/**/*.jpg
**/design-refs/**/*.jpeg
**/design-refs/**/*.webp
**/design-refs/**/*.gif

# The chosen brand mark is NOT negated here. Committing marks into design-refs
# violates hyg-no-binaries, which allows binaries only under
# public/assets/static/images/screenshots -- and that rule is right. The durable
# artifacts of the logo step are its DECISION.md and gallery.html (text, which
# commit fine) plus the SHIPPED mark in public/. The candidate PNGs are working
# files. That is also the real requirement: the mark has to ship, not be archived.

# Spec proof PNGs under evidence/ that are not under evidence/screenshots/
# (hyg-no-binaries allowlists only public|assets|static|images|screenshots).
az-planting-calendar/evidence/spec-*/**
az-planting-calendar/evidence/*.png

# Known-bad fixture content, not build output -- must be committed so the
# fixture is re-runnable on a fresh checkout (see fe-result-in-viewport-api).
!known-bad-fixtures/fe-result-in-viewport-api/bad-app/dist/
!known-bad-fixtures/fe-result-in-viewport-api/bad-app/dist/**

# Python bytecode from the pytest lane. Wiring pytest into `npm test` made
# these appear on every local run.
__pycache__/
*.pyc
pet-sitter/design-refs/appstore/*.jpg

# Scratch output of verify_results.mjs — a reproduction, not a result.
results/*.verify.json

# Vitest browser-lane failure screenshots. Regenerated by any failing run and
# they are binaries, which hyg-no-binaries forbids outside the asset dirs.
**/__screenshots__/
